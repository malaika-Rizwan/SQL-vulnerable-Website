FLASK_SECRET_KEY=change-me-to-a-long-random-string-for-local-lab-only
DATABASE_URL=sqlite:///data/sqli_lab.db
FLASK_ENV=development
FLASK_DEBUG=1

# Vercel: add FLASK_SECRET_KEY in Project Settings -> Environment Variables
# (required for sessions). DATABASE_URL is optional; defaults to /tmp on Vercel.
